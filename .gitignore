```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js.map

# Environment
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/
*.swp
*.swo

# Logs and temp files
*.log
*.tmp

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Compiled files
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.out

# Coverage
coverage/
htmlcov/
.coverage

# System
.DS_Store
Thumbs.db

# Testing
.mypy_cache/
.pytest_cache/
.nyc_output/
coverage/

# Package manager
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vs/
*.swp
*.swo
```